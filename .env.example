# Токен бота из @BotFather
BOT_TOKEN=

# Публичный https-адрес, на котором открывается мини-приложение
# (в разработке — ссылка из cloudflared / ngrok)
WEBAPP_URL=https://example.trycloudflare.com

# Короткое имя Mini App из BotFather (/newapp). Нужно для ссылок-приглашений
# вида https://t.me/<bot>/<app>?startapp=<код комнаты>
WEBAPP_SHORT_NAME=play

PORT=3000

# 1 — разрешить вход без подписи Telegram (только для локальной отладки в браузере)
DEV_MODE=1
